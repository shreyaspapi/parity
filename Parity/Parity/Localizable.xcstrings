    "login.demoModeMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo mode allows you to explore the app interface without connecting to a real Unraid server.\n\nNote: All data will be simulated and no real operations will be performed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo demo te permite explorar la interfaz de la aplicación sin conectarte a un servidor Unraid real.\n\nNota: Todos los datos serán simulados y no se realizarán operaciones reales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode démo vous permet d'explorer l'interface de l'application sans vous connecter à un serveur Unraid réel.\n\nRemarque: Toutes les données seront simulées et aucune opération réelle ne sera effectuée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Demo-Modus ermöglicht es Ihnen, die App-Oberfläche zu erkunden, ohne sich mit einem echten Unraid-Server zu verbinden.\n\nHinweis: Alle Daten werden simuliert und es werden keine echten Operationen durchgeführt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo demo permite explorar a interface do aplicativo sem se conectar a um servidor Unraid real.\n\nObservação: Todos os dados serão simulados e nenhuma operação real será realizada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "演示模式允许您在不连接到真实 Unraid 服务器的情况下探索应用程序界面。\n\n注意：所有数据都将被模拟，不会执行任何实际操作。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デモモードでは、実際の Unraid サーバーに接続することなくアプリのインターフェースを探索できます。\n\n注：すべてのデータはシミュレートされ、実際の操作は実行されません。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modalità demo ti permette di esplorare l'interfaccia dell'app senza connetterti a un vero server Unraid.\n\nNota: Tutti i dati saranno simulati e non verranno eseguite operazioni reali."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데모 모드에서는 실제 Unraid 서버에 연결하지 않고도 앱 인터페이스를 탐색할 수 있습니다.\n\n참고: 모든 데이터는 시뮬레이션되며 실제 작업은 수행되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Демо-режим позволяет изучить интерфейс приложения без подключения к реальному серверу Unraid.\n\nПримечание: Все данные симулированы, реальные операции не выполняются."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met de demomodus kun je de app-interface verkennen zonder verbinding te maken met een echte Unraid-server.\n\nOpmerking: Alle gegevens worden gesimuleerd en er worden geen echte bewerkingen uitgevoerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryb demo pozwala eksplorować interfejs aplikacji bez łączenia z prawdziwym serwerem Unraid.\n\nUwaga: Wszystkie dane są symulowane i nie są wykonywane żadne rzeczywiste operacje."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo modu, gerçek bir Unraid sunucusuna bağlanmadan uygulama arayüzünü keşfetmenizi sağlar.\n\nNot: Tüm veriler simüle edilecek ve gerçek işlemler yapılmayacaktır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتيح لك الوضع التجريبي استكشاف واجهة التطبيق دون الاتصال بخادم Unraid حقيقي.\n\nملاحظة: جميع البيانات محاكاة ولن يتم تنفيذ أي عمليات حقيقية."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Demoläget låter dig utforska appens gränssnitt utan att ansluta till en riktig Unraid-server.\n\nObs: All data är simulerad och inga riktiga operationer utförs."
          }
        }
      }
    },
