    "docker.errorDockerPermission": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access denied for Docker. Check that your API key has DOCKER read permissions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceso denegado para Docker. Verifica que tu clave API tenga permisos de lectura DOCKER."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accès refusé pour Docker. Vérifiez que votre clé API dispose des permissions de lecture DOCKER."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugriff auf Docker verweigert. Überprüfen Sie, ob Ihr API-Schlüssel DOCKER-Leseberechtigungen hat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesso negado ao Docker. Verifique se sua chave da API tem permissões de leitura DOCKER."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker 访问被拒绝。检查您的 API 密钥是否具有 DOCKER 读取权限。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker へのアクセスが拒否されました。API キーに DOCKER 読み取り権限があることを確認してください。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso negato per Docker. Verifica che la tua chiave API abbia permessi di lettura DOCKER."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker 접근이 거부되었습니다. API 키에 DOCKER 읽기 권한이 있는지 확인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к Docker запрещён. Проверьте, что API-ключ имеет права на чтение DOCKER."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegang geweigerd voor Docker. Controleer of je API-sleutel DOCKER-leesrechten heeft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odmowa dostępu do Dockera. Sprawdź, czy klucz API ma uprawnienia do odczytu DOCKER."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker için erişim reddedildi. API anahtarınızın DOCKER okuma izinlerine sahip olduğunu kontrol edin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم رفض الوصول إلى Docker. تحقق من أن مفتاح API لديه صلاحيات قراءة DOCKER."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Åtkomst nekad för Docker. Kontrollera att din API-nyckel har DOCKER-läsbehörigheter."
          }
        }
      }
    },
    "docker.errorDockerUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker service is unavailable. Start the array and ensure Docker is enabled in Settings > Docker."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio Docker no está disponible. Inicia el array y asegúrate de que Docker esté habilitado en Configuración > Docker."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service Docker n'est pas disponible. Démarrez l'array et assurez-vous que Docker est activé dans Paramètres > Docker."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker-Dienst nicht verfügbar. Starten Sie das Array und stellen Sie sicher, dass Docker in Einstellungen > Docker aktiviert ist."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Serviço Docker não está disponível. Inicie o array e certifique-se de que o Docker está ativado em Configurações > Docker."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker 服务不可用。启动阵列并确保在设置 > Docker 中启用了 Docker。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker サービスが利用できません。アレイを開始し、設定 > Docker で Docker が有効になっていることを確認してください。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il servizio Docker non è disponibile. Avvia l'array e assicurati che Docker sia abilitato in Impostazioni > Docker."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker 서비스를 사용할 수 없습니다. 어레이를 시작하고 설정 > Docker에서 Docker가 활성화되어 있는지 확인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Служба Docker недоступна. Запустите массив и убедитесь, что Docker включён в Настройки > Docker."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker-service is niet beschikbaar. Start de array en zorg ervoor dat Docker is ingeschakeld in Instellingen > Docker."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usługa Docker jest niedostępna. Uruchom macierz i upewnij się, że Docker jest włączony w Ustawienia > Docker."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker servisi kullanılamıyor. Diziyi başlatın ve Ayarlar > Docker'da Docker'ın etkin olduğundan emin olun."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خدمة Docker غير متاحة. شغّل المصفوفة وتأكد من تفعيل Docker في الإعدادات > Docker."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker-tjänsten är inte tillgänglig. Starta arrayen och se till att Docker är aktiverat i Inställningar > Docker."
          }
        }
      }
    },
