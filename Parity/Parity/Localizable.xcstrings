    "settings.clearCacheDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will clear all cached data and refresh from the server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto limpiará todos los datos en caché y actualizará desde el servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela videra toutes les données en cache et actualisera depuis le serveur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden alle zwischengespeicherten Daten gelöscht und vom Server aktualisiert."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso limpará todos os dados em cache e atualizará do servidor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将清除所有缓存数据并从服务器刷新。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、すべてのキャッシュデータが削除され、サーバーから更新されます。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo cancellerà tutti i dati memorizzati nella cache e li aggiornerà dal server."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이렇게 하면 모든 캐시된 데이터가 지워지고 서버에서 새로 가져옵니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это очистит все кэшированные данные и обновит их с сервера."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit wist alle gecachte gegevens en vernieuwt vanaf de server."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To wyczyści wszystkie dane z pamięci podręcznej i odświeży z serwera."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, tüm önbellek verilerini temizleyecek ve sunucudan yenileyecektir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى مسح جميع البيانات المخزنة مؤقتاً والتحديث من الخادم."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta rensar all cachad data och uppdaterar från servern."
          }
        }
      }
    },
