    "login.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure your device is on the same network as your Unraid server"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegúrate de que tu dispositivo esté en la misma red que tu servidor Unraid"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assurez-vous que votre appareil est sur le même réseau que votre serveur Unraid"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellen Sie sicher, dass Ihr Gerät im selben Netzwerk wie Ihr Unraid-Server ist"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Certifique-se de que seu dispositivo está na mesma rede que seu servidor Unraid"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确保您的设备与 Unraid 服务器在同一网络上"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスが Unraid サーバーと同じネットワーク上にあることを確認してください"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assicurati che il tuo dispositivo sia sulla stessa rete del server Unraid"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기가 Unraid 서버와 같은 네트워크에 있는지 확인하세요"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убедитесь, что устройство находится в той же сети, что и сервер Unraid"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zorg ervoor dat je apparaat zich op hetzelfde netwerk bevindt als je Unraid-server"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Upewnij się, że urządzenie jest w tej samej sieci co serwer Unraid"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihazınızın Unraid sunucusuyla aynı ağda olduğundan emin olun"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأكد من أن جهازك على نفس الشبكة مع خادم Unraid"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se till att din enhet är på samma nätverk som din Unraid-server"
          }
        }
      }
